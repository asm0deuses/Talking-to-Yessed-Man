def complete_tasks(tasks_remaining):


    if tasks_remaining <= 0:
        print("I did it!")
        return


    print(f"Completed a chore. {tasks_remaining - 1} chore{'s' if tasks_remaining - 1 != 1 else ''} remaining.")


    complete_tasks(tasks_remaining - 1)

try:
    total_tasks = int(input("Enter the number of chores: "))
    if total_tasks < 0:
        print("Number of tasks cannot be negative!")
    else:
        complete_tasks(total_tasks)
except ValueError:
    print("Invalid input. Please enter an integer.") # activity ends


